# Public frontend port.
FRONTEND_PORT=8080

# The browser uses this path and Nginx proxies it to the backend service.
VITE_API_BASE_URL=/api

# Backend runtime configuration.
GRIDBRICKS_CORS_ORIGINS=http://localhost:8080
GRIDBRICKS_USE_FIXTURES=false
GRIDBRICKS_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Optional Vercel runtime overrides; Docker Compose keeps the existing defaults.
# GRIDBRICKS_ELEXON_TIMEOUT_SECONDS=20
# GRIDBRICKS_ELEXON_MAX_RETRIES=1
